[color]
	ui = auto
[push]
	default = simple
[core]
	excludesfile = ~/.gitignore_global
[user]
	useConfigOnly = true
[include]
	path = ~/.gitconfig_local
[ghq]
	root = ~/workspaces/
[pull]
	rebase = false
[credential "https://dev.azure.com"]
	useHttpPath = true
[pager]
	diff = hunk pager
	show = hunk pager
	log = hunk pager
[diff]
	tool = hunk
[difftool "hunk"]
	cmd = hunk difftool "$LOCAL" "$REMOTE" "$MERGED"
[difftool]
	prompt = false
