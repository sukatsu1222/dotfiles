[color]
	ui = auto
[push]
	default = simple
[core]
	excludesfile = ~/.gitignore_global
[user]
	useConfigOnly = true
[include]
	path = ~/.gitconfig_local
[ghq]
	root = ~/dev/src
[pull]
	rebase = false
[credential]
	helper = 
	helper = /usr/local/share/gcm-core/git-credential-manager
[credential "https://dev.azure.com"]
	useHttpPath = true
