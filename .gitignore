#================================================
# ZSH
#================================================

# zsh history
.zsh_history
.zsh_sessions/

# zsh cache files
.zcompdump*
.zcompcache/

# zim zsh framework
.zim/

#================================================
# tmux
#================================================

# tmux plugins
config/tmux/plugins/

#================================================
# Karabiner Elements
#================================================

# Karabiner Elements automatic backups
config/karabiner/automatic_backups

#================================================
# neovim
#================================================

# nvim-plug plugins
config/nvim/plugged/

#================================================
# Yazi
#================================================

# yazi plugins and flavors (managed separately)
config/yazi/plugins/
config/yazi/flavors/

# yazi cache
.yazi/
*.yazi-cache/

#================================================
# Claude Code
#================================================

# Ignore everything in claude/ except managed files
claude/*
!claude/CLAUDE.md
!claude/settings.json
!claude/statusline-command.sh

# Local project-level Claude Code settings
.claude/

#================================================
# herdr
#================================================

# Ignore everything in config/herdr/ except the config file
config/herdr/*
!config/herdr/config.toml

#================================================
# hunk
#================================================

# Ignore everything in config/hunk/ except the config file
# (hunk writes machine-local state.json here)
config/hunk/*
!config/hunk/config.toml

