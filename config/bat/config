# Theme
--theme="Dracula"

# Style: line numbers, git changes, filename header, snip marker (no grid for cleaner look)
--style="numbers,changes,header-filename,snip"

# Enable italic text for comments etc.
--italic-text=always

# Pager options
--pager="less -RF"

# Syntax mapping for dotfiles
--map-syntax=".zshrc:Bash"
--map-syntax=".zshenv:Bash"
--map-syntax=".zprofile:Bash"
--map-syntax=".bashrc:Bash"
--map-syntax=".bash_profile:Bash"
--map-syntax=".gitignore:Git Ignore"
--map-syntax="*.conf:INI"
